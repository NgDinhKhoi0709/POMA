        </mxCell>
        <mxCell id="s2" value="Answer Canonicalizer (không LLM)&lt;br&gt;&lt;i&gt;normalize_match_text: yes/no · số · ngày · danh sách&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
