        </mxCell>
        <mxCell id="s2n" value="&lt;i&gt;Giữ chi phí ở mức 1×, ngang few-shot&lt;br&gt;— mốc so sánh mà POMA đang thua&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="350" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Đáp án = Null?&lt;br&gt;&lt;i&gt;không LLM&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="670" y="95" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Identify Missing Evidence&lt;br&gt;&lt;i&gt;thiếu cột hay thiếu hàng nào&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Search Table (không LLM)&lt;br&gt;&lt;i&gt;đối chiếu thực thể trong câu hỏi&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="152" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Trả lời lại kèm ô được trích,&lt;br&gt;hoặc xác nhận Null&lt;br&gt;&lt;i&gt;thành phần duy nhất được xuất Null&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="224" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;i&gt;Bằng chứng: FS+GSA xuất Null 73 câu, đúng 35&lt;br&gt;(precision 0,48 · recall 0,78) → 38 câu Null giả ≈ 3,8 điểm EM,&lt;br&gt;chỉ tốn thêm 1 lệnh gọi trên ~7% câu hỏi&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="660" y="340" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="Answer Formatter&lt;br&gt;&lt;i&gt;quy tắc (đơn vị · dấu thập phân · ngày) → GSA&lt;/i&gt;&lt;br&gt;&lt;i&gt;hiệu chỉnh trên dev&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1170" y="140" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Đáp án cuối (1 chuỗi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1170" y="280" width="230" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;i&gt;GSA đã đo: POMA-first 66,6 → 68,5 EM.&lt;br&gt;12/44 lỗi số thuần của FS chỉ là lỗi định dạng.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1170" y="350" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="cutbox" value="Đã cắt / hoãn so với sơ đồ v3 — theo số đo trên 992 câu test, không gọi thêm API" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#b85450;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="1400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="✕ Program Agent (pandas → thực thi)&lt;br&gt;&lt;i&gt;D04: trần lý thuyết 1,8–3,2 điểm, thực tế &amp;lt; 1 điểm.&lt;br&gt;Trên subset 200: 0 thắng / 2 thua / 198 hòa.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="520" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="✕ Generalist trên view thay thế&lt;br&gt;&lt;i&gt;Majority 3 view = 55,5% &amp;lt; markdown_kv đơn lẻ 56,5%.&lt;br&gt;Đa dạng có thật (oracle 66,5%) nhưng vote không khai thác được.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="520" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="✕ Consensus + Execution-grounded Adjudicator&lt;br&gt;&lt;i&gt;FS+GSA và POMA+GSA đồng ý 77,4% (EM 80,9%).&lt;br&gt;224 câu bất đồng: cần x ≥ 32,6% chỉ để hòa, ≥ 45,9% để +3 điểm.&lt;br&gt;44,2% số câu bất đồng là cả hai cùng sai → không có gì để chọn.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="520" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="✕ Nhánh Why riêng&lt;br&gt;&lt;i&gt;Why ≠ không trả lời được — gộp sai khái niệm.&lt;br&gt;Chỉ 23 câu Why trên test, không đủ cho một component.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="520" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cap" value="&lt;b&gt;Hình: POMA v3 rút gọn.&lt;/b&gt; Giữ lại ba thành phần có bằng chứng dương hoặc chi phí bằng không: chuẩn bị đầu vào xác định (Flatten V1 đã làm sạch + H1 rút gọn bảng dài), một solver duy nhất giữ chi phí ở 1×, cổng answerability là nơi duy nhất được phép xuất Null, và formatter quy tắc + GSA. Tầng ensemble và adjudicator bị cắt vì trần lợi ích tuyệt đối chỉ +5,2 điểm EM trong khi thành phần cấp bằng chứng cho nó (program agent) đã bị đo là kỳ vọng thấp ở D04." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="670" width="1400" height="70" as="geometry" />
        </mxCell>

