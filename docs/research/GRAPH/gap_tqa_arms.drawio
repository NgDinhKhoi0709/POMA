80" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Reader on full table&lt;/b&gt;&lt;br&gt;(pipe_nohdr)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;Verbalize&lt;/b&gt; (deterministic)&lt;br&gt;Có/Không → Đúng / Phải / Có / Không / Sai&lt;br&gt;by the question ending (rule from train)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1110" y="200" width="240" height="110" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Answer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="225" width="100" height="60" as="geometry"/></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=14;strokeWidth=2;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="12" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=14;strokeWidth=2;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="110"/></Array></mxGeometry></mxCell><mxCell id="13" value="Yes/No, compute,&lt;br&gt;list, Why/How" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=14;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="345"/></Array></mxGeometry></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdg