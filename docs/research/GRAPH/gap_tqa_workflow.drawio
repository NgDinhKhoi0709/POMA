<?xml version="1.0" encoding="UTF-8"?><mxfile host="drawio"><diagram name="GaP-TQA"><mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1280"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;GaP-TQA&lt;/b&gt;: mỗi lớp câu hỏi một graph có kiểu, học ngoại tuyến rồi đóng băng, test chạy bằng interpreter tất định + Qwen3-8B ở node lá" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="3" value="Tất định (code)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1240" y="6" width="170" height="20" as="geometry"/></mxCell><mxCell id="4" value="LLM 8B, decoding ràng buộc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1415" y="6" width="170" height="20" as="geometry"/></mxCell><mxCell id="5" value="Model mạnh, chỉ chạy ngoại tuyến" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1240" y="30" width="170" height="20" as="geometry"/></mxCell><mxCell id="6" value="Node phát đáp án" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1415" y="30" width="170" height="20" as="geometry"/></mxCell><mxCell id="7" value="Giai đoạn 1: NGOẠI TUYẾN trên train/dev, lặp cho từng lớp câu hỏi c (Yes/No, What, When, ...)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;fillColor=#faf5fc;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1560" height="230" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Harness&lt;/b&gt;&lt;br&gt;(model mạnh)&lt;br&gt;đọc mô tả lớp c + thư viện node + 10 ví dụ train" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="7"><mxGeometry x="30" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;G₀(c)&lt;/b&gt;&lt;br&gt;graph khởi tạo&lt;br&gt;+ kiểm kiểu, kiểm cạnh tĩnh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="7"><mxGeometry x="240" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Rehearse&lt;/b&gt;&lt;br&gt;chạy G_j(c) trên 100 câu train&lt;br&gt;(interpreter + 8B)&lt;br&gt;ghi vết từng node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="7"><mxGeometry x="450" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Quy lỗi về node&lt;/b&gt;&lt;br&gt;so vết với gold: node đầu tiên lệch&lt;br&gt;(Locate? Granularity? Null?)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="7"><mxGeometry x="660" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Sửa 1 chỗ&lt;/b&gt;&lt;br&gt;đổi node / tham số / few-shot&lt;br&gt;trên node chịu nhiều lỗi nhất" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="7"><mxGeometry x="870" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Nhận / từ chối&lt;/b&gt;&lt;br&gt;hiệu ghép cặp trên dev &amp;gt; 0&lt;br&gt;và số thua ≤ ngưỡng" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="7"><mxGeometry x="1080" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Đóng băng G*(c)&lt;/b&gt;&lt;br&gt;lưu graph + tham số&lt;br&gt;cho lớp c" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;" vertex="1" parent="7"><mxGeometry x="1290" y="60" width="170" height="90" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="10" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="hết 5 vòng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="7" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="vòng j+1 (tối đa 5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="7" source="13" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="200"/><mxPoint x="535" y="200"/></Array></mxGeometry></mxCell><mxCell id="22" value="Giai đoạn 2: TEST, không agent, 1 đến 3 lệnh gọi 8B mỗi câu" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;fillColor=#f5faff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1560" height="240" as="geometry"/></mxCell><mxCell id="23" value="Interpreter tất định chạy G*(c)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="22"><mxGeometry x="575" y="40" width="780" height="170" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;Câu hỏi&lt;/b&gt;&lt;br&gt;+&lt;br&gt;&lt;b&gt;bảng HTML&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="22"><mxGeometry x="20" y="80" width="150" height="100" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;Hint Predictor&lt;/b&gt;&lt;br&gt;(POMA hiện có)&lt;br&gt;→ lớp c" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="22"><mxGeometry x="205" y="80" width="150" height="100" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Lấy G*(c)&lt;/b&gt;&lt;br&gt;graph đã đóng băng của lớp c" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="22"><mxGeometry x="390" y="80" width="150" height="100" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;ParseCellGraph&lt;/b&gt;&lt;br&gt;lưới ô theo rowspan/colspan, forward-fill ô merge" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="22"><mxGeometry x="590" y="80" width="160" height="100" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;View triplet&lt;/b&gt;&lt;br&gt;⟨hàng › header cột : giá trị⟩&lt;br&gt;chỉ phần liên quan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="22"><mxGeometry x="780" y="80" width="160" height="100" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;Node lá 8B&lt;/b&gt;&lt;br&gt;Locate (ID ô) / JudgeBool / ExtractSpan&lt;br&gt;&lt;i&gt;enum, regex, ID hợp lệ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="22"><mxGeometry x="970" y="80" width="170" height="100" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Phát đáp án&lt;/b&gt;&lt;br&gt;Verbalize / Granularity / NullGate&lt;br&gt;(tham số học từ train)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="22"><mxGeometry x="1170" y="80" width="170" height="100" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;Đáp án&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;" vertex="1" parent="22"><mxGeometry x="1390" y="100" width="140" height="60" as="geometry"/></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="24" target="25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="25" target="26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="26" target="27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="27" target="28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="28" target="29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="29" target="30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="22" source="30" target="31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="39" value="G*(c) cho mọi lớp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#2d7600;fontColor=#2d7600;" edge="1" parent="1" source="14" target="26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="310"/><mxPoint x="485" y="310"/></Array></mxGeometry></mxCell><mxCell id="40" value="&lt;b&gt;Ví dụ minh họa&lt;/b&gt; (bảng và số liệu giả định, để thấy từng node biến đổi dữ liệu thế nào)" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="1200" height="30" as="geometry"/></mxCell><mxCell id="41" value="Ví dụ 1: lớp Yes/No, lợi ích nằm ở Verbalize (đúng cực tính nhưng sai từ là mất điểm)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;fillColor=#fffdf5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1560" height="200" as="geometry"/></mxCell><mxCell id="42" value="&lt;b&gt;Hỏi:&lt;/b&gt; Tỉnh A có diện tích lớn hơn tỉnh B, &lt;u&gt;đúng không?&lt;/u&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th&gt;Tỉnh&lt;/th&gt;&lt;th&gt;Diện tích (km²)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tỉnh A&lt;/td&gt;&lt;td&gt;3.360&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tỉnh B&lt;/td&gt;&lt;td&gt;2.095&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="41"><mxGeometry x="20" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="43" value="&lt;b&gt;ParseCellGraph + triplet&lt;/b&gt;&lt;br&gt;Tỉnh A › Diện tích : 3.360&lt;br&gt;Tỉnh B › Diện tích : 2.095" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="41"><mxGeometry x="360" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="44" value="&lt;b&gt;Locate (8B)&lt;/b&gt;&lt;br&gt;→ {r1c2, r2c2}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="41"><mxGeometry x="640" y="60" width="180" height="110" as="geometry"/></mxCell><mxCell id="45" value="&lt;b&gt;JudgeBool (8B, enum)&lt;/b&gt;&lt;br&gt;3.360 &amp;gt; 2.095&lt;br&gt;→ True" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="41"><mxGeometry x="860" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="46" value="&lt;b&gt;Verbalize&lt;/b&gt;&lt;br&gt;luật từ train: đuôi &lt;i&gt;“đúng không?”&lt;/i&gt;&lt;br&gt;+ True → “Đúng”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="41"><mxGeometry x="1100" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="47" value="Đúng" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=14;" vertex="1" parent="41"><mxGeometry x="1360" y="85" width="170" height="60" as="geometry"/></mxCell><mxCell id="48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="41" source="42" target="43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="41" source="43" target="44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="41" source="44" target="45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="41" source="45" target="46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="41" source="46" target="47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="53" value="Nếu reader trả “Có” thì sai EM. Trên FS+GSA, node này sửa 34 câu, làm sai 3 câu (+3,13 EM)." style="text;html=1;fontSize=11;align=left;fontStyle=2;fontColor=#555555;" vertex="1" parent="41"><mxGeometry x="360" y="172" width="1170" height="24" as="geometry"/></mxCell><mxCell id="54" value="Ví dụ 2: lớp What trên bảng có header merge, lợi ích nằm ở ParseCellGraph + Locate theo ID ô" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;fillColor=#fffdf5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1560" height="200" as="geometry"/></mxCell><mxCell id="55" value="&lt;b&gt;Hỏi:&lt;/b&gt; Dân số tỉnh C năm 2024 là bao nhiêu nghìn người?&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th rowspan=&quot;2&quot;&gt;Tỉnh&lt;/th&gt;&lt;th colspan=&quot;2&quot;&gt;Dân số (nghìn người)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th&gt;2019&lt;/th&gt;&lt;th&gt;2024&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tỉnh C&lt;/td&gt;&lt;td&gt;1.134&lt;/td&gt;&lt;td&gt;1.245&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="54"><mxGeometry x="20" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="56" value="&lt;b&gt;ParseCellGraph + triplet&lt;/b&gt;&lt;br&gt;header merge → đường dẫn:&lt;br&gt;Tỉnh C › Dân số › &lt;b&gt;2024&lt;/b&gt; : 1.245&lt;br&gt;Tỉnh C › Dân số › 2019 : 1.134" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="54"><mxGeometry x="360" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="57" value="&lt;b&gt;Locate (8B)&lt;/b&gt;&lt;br&gt;→ r3c3&lt;br&gt;&lt;i&gt;ID sai → fallback Read&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="54"><mxGeometry x="640" y="60" width="180" height="110" as="geometry"/></mxCell><mxCell id="58" value="&lt;b&gt;Granularity&lt;/b&gt;&lt;br&gt;chính sách lớp What:&lt;br&gt;phát nguyên văn ô" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="54"><mxGeometry x="860" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="59" value="&lt;b&gt;NullGate&lt;/b&gt;&lt;br&gt;có ô hợp lệ → giữ đáp án" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="54"><mxGeometry x="1100" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="60" value="1.245" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=14;" vertex="1" parent="54"><mxGeometry x="1360" y="85" width="170" height="60" as="geometry"/></mxCell><mxCell id="61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="54" source="55" target="56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="54" source="56" target="57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="54" source="57" target="58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="54" source="58" target="59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="54" source="59" target="60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="66" value="Flatten phẳng dễ làm model đọc nhầm cột 2019/2024. Triplet ghi rõ đường dẫn header nên chỉ còn phải chọn đúng ID ô." style="text;html=1;fontSize=11;align=left;fontStyle=2;fontColor=#555555;" vertex="1" parent="54"><mxGeometry x="360" y="172" width="1170" height="24" as="geometry"/></mxCell><mxCell id="67" value="Ví dụ 3: lớp When, lợi ích nằm ở Granularity (và NullGate khi bảng không có dữ liệu)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;fillColor=#fffdf5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1560" height="200" as="geometry"/></mxCell><mxCell id="68" value="&lt;b&gt;Hỏi:&lt;/b&gt; Trường D được thành lập vào năm nào?&lt;br&gt;&lt;span style='color:#b85450'&gt;(biến thể: “... năm 2030?”)&lt;/span&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th&gt;Trường&lt;/th&gt;&lt;th&gt;Năm thành lập&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trường D&lt;/td&gt;&lt;td&gt;Năm 1709&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="67"><mxGeometry x="20" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="69" value="&lt;b&gt;ParseCellGraph + triplet&lt;/b&gt;&lt;br&gt;Trường D › Năm thành lập :&lt;br&gt;Năm 1709" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="67"><mxGeometry x="360" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="70" value="&lt;b&gt;Locate (8B)&lt;/b&gt;&lt;br&gt;→ r1c2&lt;br&gt;&lt;span style='color:#b85450'&gt;(biến thể: không có ID nào)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="67"><mxGeometry x="640" y="60" width="180" height="110" as="geometry"/></mxCell><mxCell id="71" value="&lt;b&gt;Granularity&lt;/b&gt;&lt;br&gt;tham số học từ train lớp When:&lt;br&gt;giữ tiền tố “Năm”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="67"><mxGeometry x="860" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="72" value="&lt;b&gt;NullGate&lt;/b&gt;&lt;br&gt;có ô → giữ&lt;br&gt;&lt;span style='color:#b85450'&gt;không có ô → “Null”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="67"><mxGeometry x="1100" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="73" value="Năm 1709" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=14;" vertex="1" parent="67"><mxGeometry x="1360" y="85" width="170" height="60" as="geometry"/></mxCell><mxCell id="74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="67" source="68" target="69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="67" source="69" target="70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="67" source="70" target="71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="67" source="71" target="72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="67" source="72" target="73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="79" value="Reader thường trả “1709” nên sai EM so với gold “Năm 1709”. Hướng giữ hay bỏ tiền tố phải đo trên dev, không đoán." style="text;html=1;fontSize=11;align=left;fontStyle=2;fontColor=#555555;" vertex="1" parent="67"><mxGeometry x="360" y="172" width="1170" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>