<mxfile host="drawio"><diagram name="A1"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;A1: reader + Verbalize (the GaP-TQA control)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;+&lt;br&gt;&lt;b&gt;HTML table&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="150" height="110" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Flatten V1 (v1_raw)&lt;/b&gt; (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="330" height="36" as="geometry"/></mxCell><mxCell id="5" value="Tỉnh &amp;lt;header&amp;gt;|Dân số (nghìn) &amp;lt;header&amp;gt;|Dân số (nghìn) &amp;lt;header&amp;gt;&lt;br&gt;Tỉnh &amp;lt;header&amp;gt;|2019 &amp;lt;header&amp;gt;|2024 &amp;lt;header&amp;gt;&lt;br&gt;Đà Nẵng|1.134|1.245&lt;br&gt;Huế|1.128|1.160" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#fffdf5;strokeColor=#bbbbbb;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="116" width="330" height="110" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Reader&lt;/b&gt; (Qwen3-8B, 1 call)&lt;br&gt;rules: print only a short answer,&lt;br&gt;copy cell text verbatim, Có/Không, Null&lt;br&gt;+ 2 train Q–A examples per class" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="300" height="130" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Verbalize&lt;/b&gt; (deterministic)&lt;br&gt;Có/Không → Đúng / Phải / Có / Không / Sai&lt;br&