# Local secrets and environment configuration
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Isolated feature worktrees
.worktrees/

# Vendored baseline runtime artifacts
outputs/baselines/
tmp/
baselines/**/tmp/
baselines/**/*.db

# Generated experiment results, traces, and local analysis artifacts
outputs/
.codegraph/

# Large local binaries: model checkpoints, third-party papers, compiled decks
checkpoints/
docs/**/*.pdf
docs/**/*.docx
slide/*.pdf
slide/render/
