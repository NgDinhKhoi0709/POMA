          <mxGeometry x="40" y="284" width="250" height="56" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="H1 — chọn hàng cho bảng dài&lt;br&gt;&lt;i&gt;&amp;gt; 2.000 token → header + top-k BM25&lt;/i&gt;&lt;br&gt;&lt;i&gt;−46,6% token, EM không giảm (D10)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="358" width="250" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Routed Specialist(s)&lt;br&gt;&lt;i&gt;POMA hiện có · hint-routed · T=0&lt;/i&gt;&lt;br&gt;&lt;i&gt;1 lệnh gọi LLM / câu&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
